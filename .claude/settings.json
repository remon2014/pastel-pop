      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm audit)",
      "Bash(npm ls *)",
      "Bash(npm outdated)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)"
